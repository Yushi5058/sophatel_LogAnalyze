# Variables pour docker compose (RM-28)
# Copiez ce fichier en .env dans ce dossier, puis : docker compose up --build

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sophatel_logs

# ── Sécurité ──────────────────────────────────────────────────────────────────
# OBLIGATOIRE — générez une vraie clé : openssl rand -hex 32
SECRET_KEY=changez-moi-openssl-rand-hex-32
# Recommandé — chiffrement des identifiants VPS : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# ── Compte admin initial ──────────────────────────────────────────────────────
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et journalisé
# une seule fois au premier démarrage (à noter dans les logs `docker compose logs api`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Options ───────────────────────────────────────────────────────────────────
USE_MOCK=false            # true = données simulées (démo sans vrais VPS)
DEBUG=false
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SCHEDULER_ENABLED=true
API_PORT=8000
