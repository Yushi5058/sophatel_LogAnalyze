# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/sophatel_logs

# ── API ───────────────────────────────────────────────────────
SECRET_KEY=changeme-secret-key
DEBUG=true

# ── Chemins ───────────────────────────────────────────────────
LOG_DIR=logs
DATA_DIR=data

# ── SSH (optionnel, si pas dans vps.yaml) ────────────────────
# SSH_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSPHRASE=

# ── Mode développement ────────────────────────────────────────
USE_MOCK=true
