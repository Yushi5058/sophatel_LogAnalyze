# ── PostgreSQL ────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/db

# ── API ───────────────────────────────────────────────────────
# SECRET_KEY=<generer avec: openssl rand -hex 32>
# DEBUG=true expose le détail des erreurs au client — laisser false en production
DEBUG=false

# ── Compte admin initial (créé au 1er démarrage si la table est vide) ──
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et
# affiché UNE fois dans les logs au démarrage.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<choisir un mot de passe fort>


# ── Chemins ───────────────────────────────────────────────────
LOG_DIR=logs
DATA_DIR=data

# ── Chiffrement des identifiants VPS (Fernet) ─────────────────
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si absent, une clé est dérivée de SECRET_KEY (dépannage uniquement).
# CREDENTIALS_KEY=

# ── SSH (optionnel, si pas dans vps.yaml) ────────────────────
# SSH_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSPHRASE=
# Vérification de la clé d'hôte (anti-MITM) :
#  - SSH_STRICT_HOST_KEY=true  -> rejette tout serveur inconnu (le plus sûr)
#  - false (défaut) -> TOFU : mémorise la clé au 1er contact, détecte un changement ensuite
# SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# SSH_STRICT_HOST_KEY=false

# ── Mode développement ────────────────────────────────────────
USE_MOCK=true
